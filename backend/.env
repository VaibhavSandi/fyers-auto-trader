# ============================================================
# FYERS AUTO TRADER - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file or share it with anyone.
# ============================================================

# --- FYERS API APP CREDENTIALS -------------------------------------------
# Create an app at https://myapi.fyers.in/dashboard to get these.
FYERS_CLIENT_ID=1EIWY9RMUR-100
FYERS_SECRET_KEY=WV2M66CGR2
# Must exactly match the "Redirect URL" configured on the FYERS app dashboard.
# The backend runs a local server that listens on this exact path.
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/broker/fyers/callback

# --- APPLICATION SECURITY -------------------------------------------------
# Used to encrypt the FYERS access token at rest in the local database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=r2bGbZ85-IlCb7Id7XmWPQZve8a6GkN9IFFd8MbjkHY=

# --- SERVER ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- DATABASE ----------------------------------------------------------------
DATABASE_PATH=./data/trading.db

# --- SAFETY DEFAULTS (used only if a session has no explicit value yet) ----
# These are hard application-wide ceilings. No risk profile may exceed them,
# even in Aggressive mode. Read README.md before changing these.
HARD_MAX_DAILY_LOSS_PCT=5.0
HARD_MAX_RISK_PER_TRADE_PCT=2.0
HARD_MAX_OPEN_POSITIONS=3
HARD_MAX_TRADES_PER_DAY=8

# --- MARKET HOURS (IST, 24h clock) -----------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
ENTRY_CUTOFF_TIME=14:45
SQUARE_OFF_TIME=15:12

# --- LOGGING -----------------------------------------------------------------
LOG_LEVEL=INFO
