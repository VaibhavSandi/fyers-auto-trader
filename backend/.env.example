# ============================================================
# FYERS AUTO TRADER - ENVIRONMENT CONFIGURATION
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file or share it with anyone.
# ============================================================

# --- FYERS API APP CREDENTIALS -------------------------------------------
# Create an app at https://myapi.fyers.in/dashboard to get these.
FYERS_CLIENT_ID=XXXXXXXX-100
FYERS_SECRET_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Must exactly match the "Redirect URL" configured on the FYERS app dashboard
# EXACTLY (FYERS silently rejects the login otherwise). The backend accepts
# the callback on either /api/auth/fyers/callback or /api/broker/fyers/callback -
# use whichever one is already registered on your FYERS app dashboard.
FYERS_REDIRECT_URI=http://127.0.0.1:8000/api/auth/fyers/callback

# --- APPLICATION SECURITY -------------------------------------------------
# Used to encrypt the FYERS access token at rest in the local database.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# --- SERVER ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- DATABASE ----------------------------------------------------------------
DATABASE_PATH=./data/trading.db

# --- SAFETY DEFAULTS (used only if a session has no explicit value yet) ----
# These are hard application-wide ceilings. No risk profile may exceed them,
# even in Aggressive mode. Read README.md before changing these.
HARD_MAX_DAILY_LOSS_PCT=5.0
HARD_MAX_RISK_PER_TRADE_PCT=2.0
HARD_MAX_OPEN_POSITIONS=3
HARD_MAX_TRADES_PER_DAY=8

# --- MARKET HOURS (IST, 24h clock) -----------------------------------------
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
# No new entries are taken before ENTRY_START_TIME - the opening minutes are
# typically too volatile/noisy to trust (standard intraday practice).
ENTRY_START_TIME=09:30
ENTRY_CUTOFF_TIME=14:45
SQUARE_OFF_TIME=15:12

# --- LOGGING -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- AUTOMATIC SELF-LEARNING (opt-in, OFF by default) -----------------------
# When true, once a day (after the market closes) the app automatically
# re-runs the existing backtest -> walk-forward -> compare-and-decide
# pipeline for every registered strategy against the current baseline,
# instead of you calling POST /api/learning/experiment by hand. Promotion is
# still evidence-gated exactly as it is for a manual run (see
# app/learning/promotion.py) and a promoted version is still NEVER wired
# into live/paper trading automatically - that stays a separate, explicit
# step. Check GET /api/learning/auto-status and GET /api/learning/experiments
# to see what it has decided.
ENABLE_AUTO_LEARNING=false
AUTO_LEARNING_RUN_TIME=16:00
AUTO_LEARNING_SYMBOLS=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY
AUTO_LEARNING_LOOKBACK_DAYS=60
AUTO_LEARNING_TRAIN_DAYS=3
AUTO_LEARNING_TEST_DAYS=2
AUTO_LEARNING_EMBARGO_DAYS=1

# --- ALERTING (opt-in, OFF unless both are set) -----------------------------
# Get a bot token from @BotFather on Telegram, send your new bot any message,
# then open https://api.telegram.org/bot<token>/getUpdates in a browser to
# find your chat id. Used to alert on: kill switch activation, daily loss
# limit / consecutive-loss pause / max-drawdown breach, backend (re)start
# (recovery required), and FYERS connectivity going down or recovering.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
